<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="dusk" name="Dusk" kind="dark">
    <description>Dusk theme</description>

    <style name="text" background="#1f3048" foreground="#fffff0"/>
    <style name="cursor" background="#008000" foreground="#000000"/>
    
    <style name="line-numbers" foreground="#cdc1c5"/>

    <style name="search-match" background="#ffe4c4" foreground="#4a708b"/>

    <style name="diff:added-line" background="#e0ffff" foreground="#0000ff"/>
    <style name="diff:changed-line" background="#7a8b8b" foreground="#ffffff"/>
    <style name="diff:removed-line" background="#e0ffff" foreground="#add8e6"/>

    <style name="def:constant" foreground="#cdc1c5"/>
    <style name="def:string" foreground="#9ac0cd"/>
    <style name="def:special-char" foreground="#daa520"/>
    <style name="def:statement" foreground="#f0e68c"/>
    <style name="def:error" background="#faf0e6" foreground="#ff0000"/>
    
    <style name="def:comment" foreground="#708090"/>
    
    <style name="def:identifier" foreground="#ffebcd"/>
    <style name="def:preprocessor" foreground="#ffa0a0"/>
    <style name="def:type" foreground="#ffdead"/>
</style-scheme>
