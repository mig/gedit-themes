<?xml encoding="UTF-8"?>
<style-scheme id="neon" name="Neon" kind="dark">
    <description>Neon theme</description>
    
    <style name="text" background="#303030" foreground="#f0f0f0"/>
    <style name="search-match" background="#808000" foreground="#ffffa8"/>
    <style name="cursor" background="#8040ff" foreground="#70ffc0"/>
    <style name="line-numbers" foreground="#707070"/>

    <style name="diff:changed-line" background="#601830" foreground="#e03870"/>
    <style name="diff:removed-line" background="#0020a0" foreground="#a0d0ff"/>
    <style name="diff:added-line" background="#0020a0" foreground="#a0d0ff"/>

    <style name="def:comment" foreground="#c0c0c0"/>
    <style name="def:constant" foreground="#92d4ff"/>
    <style name="def:error" background="#8000ff" foreground="#ffffff"/>
    <style name="def:identifier" foreground="#40f8f8"/>
    <style name="def:preprocessor" foreground="#ffa8ff"/>
    <style name="def:special-char" foreground="#ffc890"/>
    <style name="def:statement" foreground="#dcdc78"/>
    <style name="def:type" foreground="#60f0a8"/>
</style-scheme>
