<?xml encoding="UTF-8"?>
<style-scheme id="warm_grey" name="Warm_Grey" kind="light">
    <description>Warm Grey</description>

    <style name="text" background="#f0f0f0" foreground="#444240"/>
    <style name="current-line" background="#e4e2e0"/>
    <style name="cursor" background="#b8b4b0" foreground="#000000"/>
    <style name="line-numbers" background="#d8d4d0" foreground="#646260" italic="true"/>
    <style name="bracket-match" background="#747270" foreground="#ffffff" bold="true"/>

    <style name="def:comment" foreground="#848280" italic="true"/>
    <style name="def:constant" foreground="#000000"/>
    <style name="def:string" foreground="#804020"/>
    <style name="def:number" foreground="#406020"/>
    <style name="def:statement" foreground="#607080" bold="true"/>
    <style name="def:type" foreground="#606060" bold="true"/>
    <style name="def:function" foreground="#203040" bold="true"/>
    <style name="def:identifier" foreground="#545250"/>
    <style name="def:preprocessor" foreground="#705060" bold="true"/>
    <style name="def:error" background="#ffffff" foreground="#a02000"/>
    
    <style name="def:special-char" foreground="#602000"/>

    <style name="diff:changed-line" background="#e4e2e0" italic="true"/>
    <style name="diff:added-line" background="#c0e0d0" bold="true"/>
    <style name="diff:removed-line" background="#f0a0a0"/>
</style-scheme>
