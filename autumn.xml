<?xml encoding="UTF-8"?>
<style-scheme id="autumn" name="Autumn" kind="light">
  <description>Autumn theme for gedit 49</description>

  <style name="text" foreground="#000000" background="#f0f2f0"/>
  <style name="cursor" foreground="#000000" background="#ff0000"/>
  <style name="line-numbers" foreground="#a52a2a" background="#d3d3d3"/>
  <style name="search-match" foreground="#000000" background="#ffff00"/>

  <style name="diff:added-line" foreground="#aaeeaa" background="#447744"/>
  <style name="diff:changed-line" foreground="#ffffe0" background="#ddbb55"/>
  <style name="diff:removed-line" foreground="#336633" background="#aaccaa"/>

  <style name="def:comment" foreground="#ccaaaa"/>
  <style name="def:constant" foreground="#bb6666"/>
  <style name="def:identifier" foreground="#008b8b"/>
  <style name="def:statement" foreground="#44aa44"/>
  <style name="def:preprocessor" foreground="#a9a9a9"/>
  <style name="def:type" foreground="#bb9900"/>
  <style name="def:function" foreground="#0055cc"/>
</style-scheme>
